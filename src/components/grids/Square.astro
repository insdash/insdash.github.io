---
import { getCollection } from 'astro:content';
import ProjectCard from '@/components/grids/ProjectCard.astro';
import Button from '@/components/UI/Button.astro';

interface Props {
  /** Cards shown before "Load more". Omit to show every project at once. */
  limit?: number;
  heading?: string;
}

const { limit, heading = 'Selected work' } = Astro.props as Props;

const projects = await getCollection('projects');
projects.sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;

  const aDate = a.data.created;
  const bDate = b.data.created;

  if (!aDate && !bDate) return 0;
  if (!aDate) return 1;
  if (!bDate) return -1;

  return new Date(bDate).getTime() - new Date(aDate).getTime();
});
---

{/* The homepage had no section headings at all, so the card titles below had
    nothing to be subordinate to. */}
<h2 class="sectionHeading">{heading}</h2>

<div class="gridLayout" id="projects-grid">
  {
    projects.map((project, index) => (
      <div
        class={`project-item ${limit === undefined || index < limit ? '' : 'hidden'}`}
        id={`project-${index}`}
        tabindex="-1"
      >
        <ProjectCard project={project} />
      </div>
    ))
  }
</div>

<div class="moreButton">
  <div class="flex justify-end gap-2">
    {
      limit !== undefined && projects.length > limit && (
        <Button
          id="load-more-button"
          label="Load more projects..."
          variant="outline"
          color="primary"
          size="md"
        />
      )
    }
  </div>
  <p id="load-more-status" class="sr-only" role="status" aria-live="polite"></p>
</div>

<script>
  const btn = document.getElementById('load-more-button');
  const status = document.getElementById('load-more-status');

  if (btn) {
    btn.addEventListener('click', () => {
      const items =
        document.querySelectorAll<HTMLElement>('.project-item.hidden');
      const toShow = Array.from(items).slice(0, 3); // show 3 more
      toShow.forEach((item) => item.classList.remove('hidden'));

      const remaining = document.querySelectorAll('.project-item.hidden').length;


      if (status) {
        status.textContent = `${toShow.length} more project${
          toShow.length === 1 ? '' : 's'
        } shown, ${remaining} remaining.`;
      }

      // hide button if all items are now visible
      if (remaining === 0) {
        toShow[0]?.focus();
        btn.style.display = 'none';
      }
    });
  }
</script>

<style>
  @reference "@/styles/global.css";
  .sectionHeading {
    @apply px-[2.5rem] mx-auto max-w-[80rem] mb-4;
  }

  .gridLayout {
    @apply p-4 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-3 gap-4;
  }
  .moreButton {
    @apply px-[2.5rem] my-[2rem] mx-auto max-w-[80rem];
  }

  .project-item {
    @apply grid flex-col;
  }

  .project-item.hidden {
    display: none;
  }
</style>
