---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;

const mainImage = project.data.thumbnail ?? project.data.image;
---

{mainImage && (
<div class="relative group thumbnail overflow-hidden">
  {/* Image */}
  <Image
    src={mainImage}
    alt={project.data.title}
    widths={[640, 1024, 1600]}
    sizes="(min-width: 900px) 80rem, 100vw"
    class="w-full aspect-16/10 object-cover object-center transition-transform duration-300 ease-in-out group-hover:scale-105"
  />

  {/* Overlay with text */}
  <div class="glassHover">
    <span
      aria-hidden="true"
      class="text-h3 font-semibold text-(--background-color) drop-shadow-[1px_1px_2px_var(--color-caption-secondary)]"
    >
      {project.data.title}
    </span>
  </div>
</div>
)}

<style>
  @reference "@/styles/global.css";

  .thumbnail {
    @apply w-full overflow-hidden;
  }

  /* Both rules here were scoped to `html.light_mode` / `html.dark_mode` while the
     theme class sat on <body>, so neither matched and `.glassHover` had no base
     rule at all — the overlay div was entirely unstyled and its title sat as bare
     text on the image. One rule now, with the dark half as a variant. */
  .glassHover {
    @apply absolute inset-0 flex flex-col items-center justify-center
    bg-linear-to-t from-black/5 via-black/2 to-transparent
    border border-black/10 backdrop-blur-md
    rounded-xl opacity-0 transition-opacity duration-300 group-hover:opacity-100
    dark:from-white/20 dark:via-white/10 dark:to-white/5 dark:border-white/25;
  }
</style>
