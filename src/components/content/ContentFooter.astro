---
import Button from '@/components/UI/Button.astro';

const { project, baseUrl } = Astro.props;

// "Project Credit: insdash" read as the studio crediting itself on its own
// self-initiated work. Say what the link actually leads to instead.
const selfInitiated = /self[-\s]?initiated/i.test(project.data.type ?? '');
const clientLabel = selfInitiated
  ? 'Self-initiated by insdash'
  : `Client: ${project.data.client}`;
const linkHint = selfInitiated ? 'See it live…' : 'Go to the website…';

---

<section>
      <div class="contentFooter"> 
            <div class="mb-[2rem]">
                  {project.data.completed}
            </div>
     
            {project.data.clientLink ? (
                  <div class="group relative inline-block">
                        <a
                              href={project.data.clientLink}
                              class="item_link"
                              target="_blank"
                              rel="noopener noreferrer"
                              aria-label={`${clientLabel} (opens in a new tab)`}>{clientLabel}</a>
                        <span class="item_link_hover">{linkHint}</span>
                  </div>
            ) : (
                  <div>{clientLabel}</div>
            )}

            <div class="flex justify-end">
                  <Button
                  href={`${baseUrl}projects/`}
                  label="Check more projects..."
                  color="primary"
                  variant="outline"
                  size="md"
                  />
            </div>
      </div>

</section>


<style>
      @reference "@/styles/global.css";

      .item_link {
            @apply text-[var(--color-text-primary)] hover:text-[var(--color-text-hover)] hover:text-shadow-[0.05rem_0.05rem_var(--color-text-primary)];
      }

      .item_link_hover{
            @apply absolute top-full left-1/2 transform mt-2 hidden px-2 py-1 text-xs text-white bg-[var(--color-text-hover)] rounded group-hover:block whitespace-nowrap;
      }

      
</style>