---
import type { CollectionEntry } from 'astro:content';
import Tag from '@/components/UI/Tag.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props as Props;
const meta = project.data;

// menuGen's `client` is insdash itself, so a "Client" label would read as a
// studio hiring itself. Self-initiated work says what it is instead.
const selfInitiated = /self[-\s]?initiated/i.test(meta.type ?? '');

---
<section class="meta space-y-16">
  <div class="space-y-16">
    {/* h1, not h2: this is the page title. As an h2 it left both case studies
        with no h1 and made every markdown `##` a sibling rather than a child. */}
    <h1 class="projectTitle">{meta.title}</h1>
    <p class="projectDescription lead">{meta.description}</p>
    <div class="my-[2rem]">
      {meta.tags && <Tag tags={meta.tags} />}
    </div>
  </div>
    
  {/* A description list is what this is. It was an <ul> whose <li>s each held
      two <ol>s — one for the label, one for the value — which is neither a list
      nor an ordered one. Labels are mono, values sans. */}
  <dl class="projectDetail grid grid-cols-1 md:grid-cols-3 gap-6">
    {meta.scope && (
      <div class="col-span-1 md:col-span-3">
        <dt class="meta-label">What we did</dt>
        <dd>{meta.scope}</dd>
      </div>
    )}
    {meta.timeline && (
      <div>
        <dt class="meta-label">Timeline</dt>
        <dd>{meta.timeline}</dd>
      </div>
    )}
    {meta.completed && (
      <div>
        <dt class="meta-label">Delivered</dt>
        <dd>{meta.completed}</dd>
      </div>
    )}
    {meta.client && (
      <div>
        <dt class="meta-label">{selfInitiated ? 'Origin' : 'Client'}</dt>
        <dd>{selfInitiated ? 'Self-initiated' : meta.client}</dd>
      </div>
    )}

    {/* The judgment the engagement turned on. Every project file already
        carried this; nothing rendered it until now. */}
    {!!meta.focus?.length && (
      <div class="col-span-1 md:col-span-3">
        <dt class="meta-label">Focus</dt>
        <dd>{meta.focus.join(' · ')}</dd>
      </div>
    )}

    {/* Tools full width */}
    {meta.tools && (
      <div class="col-span-1 md:col-span-3">
        <dt class="meta-label">Tools</dt>
        <dd>{meta.tools.join(', ')}</dd>
      </div>
    )}

    {/* Approach full width */}
    {meta.approach && (
      <div class="col-span-1 md:col-span-3">
        <dt class="meta-label">Approach</dt>
        <dd>{meta.approach}</dd>
      </div>
    )}
  </dl>

</section>


<style>
  @reference "@/styles/global.css";

  .meta{
    @apply max-w-[80rem] mx-auto my-8 px-[2.5rem]; 
  }


  .projectDetail{
    @apply border rounded-sm p-[0.5rem];
  }

  .projectDetail dt {
    @apply pb-[0.25rem];
  }

  .projectDetail dd {
    @apply m-0;
  }

</style>