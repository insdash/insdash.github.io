---
import SEO from '@/components/layout/SEO.astro';
import AEO from '@/components/layout/AEO.astro';
import type { SeoData } from '@/ts/type.ts';

const { title, description, image, url, keywords, noindex } = Astro.props as SeoData;

const baseUrl = import.meta.env.SITE || 'https://insdash.ch';
const base = import.meta.env.BASE_URL;
const pageUrl = url ?? Astro.url.pathname;
const canonicalUrl = `${baseUrl}${pageUrl.startsWith('/') ? pageUrl : `/${pageUrl}`}`;

---

<head>
  {/* Runs synchronously during head parsing, before first paint. It previously
       waited for DOMContentLoaded (it had to — it wrote to document.body, which
       does not exist yet at this point), so dark-mode users saw a white flash on
       every navigation. Writing to documentElement instead removes it. */}
  <script is:inline>
    (() => {
      const pref = localStorage.getItem('mode');
      document.documentElement.dataset.theme =
        pref === 'light_mode' ? 'light' : pref === 'dark_mode' ? 'dark' : 'system';
    })();
  </script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta property="og:type" content="website" />
  <meta name="author" content="insdash" />
  <meta name="copyright" content="insdash" />
  <meta name="color-scheme" content="light dark" />
  <link rel="icon" type="image/svg+xml" href={`${base}insdash.svg`} />
  <link
    rel="icon"
    type="image/png"
    sizes="32x32"
    href={`${base}images/logo/insdash_dark.png`}
  />
  {/* The icon iOS and iPadOS use when the site is saved to the home screen. */}
  <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
  {/* Structured data for search and answer engines. One @graph per page,
       built from the same content collections the pages render. */}
  <AEO
    title={title}
    description={description}
    image={image}
    canonicalUrl={canonicalUrl}
    noindex={noindex}
  />
  <SEO
    title={title}
    description={description}
    image={image}
    url={canonicalUrl}
    keywords={keywords}
    noindex={noindex}
  />
  {/* Fonts. DM Sans carries body and headings, DM Mono the wordmark, tags and
       metadata labels. `crossorigin` is required on the gstatic preconnect or it
       opens the wrong connection and does nothing. */}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=DM+Sans:opsz,wght@9..40,400..700&display=swap"
    rel="stylesheet"
  />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=close,dark_mode,light_mode,location_on,menu,tonality"
  />
  {/* GA */}
  {/* Analytics is loaded once, by <Analytics> in Layout.astro. This file used
       to hardcode a second gtag block, so every pageview was counted twice. */}
</head>
