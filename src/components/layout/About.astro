---

interface Props {
  profileImage?: string;
  gifImage?: string;
}

const {
  profileImage = 'images/logo/insdash_dark.png',
  gifImage = 'images/logo/insdash_w.png',
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL;

const profileImagePath = `${baseUrl}${profileImage}`;
const gifImagePath = `${baseUrl}${gifImage}`;
---

<section class="aboutMe">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    {/* Text section */}
    <div class="lg:col-span-9 space-y-6">
      {/* The h1 above already says "We design it and we build it", and Zürich
          appears twice in the intro — so this heading answers the question the
          reader actually has after the project grid, rather than restating the
          pitch. "Who you'll be working with" is the h1 on /about; reusing it
          here made this section read as a teaser for that page. */}
      <p class="eyebrow">The studio</p>
      <h2>You will always talk to the person building it.</h2>

      <p>
        We design and build. There is no handover between the two halves, which
        is why a design engagement here can become working software rather than
        a specification for somebody else to interpret — and why we can tell you
        when the answer is <strong>don't build this</strong>.
      </p>
      <p>
        We scope in writing, hand over things you can maintain without us, and
        stay on for maintenance when you want us to. We work between Switzerland
        and Asia — for international businesses setting up here, and Swiss
        businesses selling outward.
      </p>
    </div>

    {/* Images section */}
    <div class="lg:col-span-3 flex flex-col items-center gap-4">
      <div class="static_image group">
        {/* static profile image */}
        <img
          src={profileImagePath}
          alt="insdash"
          class="profile_image group-hover:opacity-0"
        />

        {/* GIF image */}
        <img
          src={gifImagePath}
          alt=""
          aria-hidden="true"
          class="profile_image absolute top-0 left-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100"
        />
      </div>
    </div>
    
  </div>
</section>

<style>
  @reference "@/styles/global.css";
  .aboutMe {
    @apply px-[2.5rem] my-[4rem] mx-auto max-w-[80rem];
  }

  .static_image {
    @apply relative w-72 h-72;
  }

  .profile_image {
    @apply w-full h-full rounded-full transition-opacity duration-500;
  }

  .showgif {
    @apply hidden;
  }
</style>
