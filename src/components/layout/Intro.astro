---
import { getEntry } from 'astro:content';
import Tag from '@/components/UI/Tag.astro';

interface Props {
  description?: string;
}

// Both the blurb and the tags come from src/content/services/services.md, so
// editing that file is enough to change what the intro advertises.
const entry = await getEntry('services', 'services');

if (!entry)
  throw new Error('Missing content collection entry: services/services.md');

const { description = entry.data.homeBlurb } = Astro.props as Props;

const services = entry.data.services.map((s) => s.name);
---

<script></script>

<div class="intro">
  {/* The page had no h1 at all, and the brand name was an h3 with the section
      head an h4 — levels chosen for size rather than structure. The wordmark is
      a wordmark, so it stops being a heading; the positioning line becomes the h1. */}
  <p class="eyebrow">insdash — Zürich</p>
  <h1 class="intro_headline">We design it and we build it.</h1>
  <p class="intro_item lead">
    {description}
  </p>
  <h2 class="intro_item">Here is what we do</h2>
  <div class="mt-[2rem]">
    <Tag tags={services} />
  </div>

</div>

<div class="intro">
  <div class="flex justify-end items-end"><p class="intro_item"><span class="material-symbols-outlined">location_on</span>Based in Zürich</p></div>
</div>



<style>
  @reference "@/styles/global.css";
  .intro {
    @apply px-[2.5rem] my-[var(--space-section)] mx-auto;
  }

  .intro_item {
    @apply m-0;
  }

  .intro_headline {
    @apply text-display font-medium mt-2 mb-6;
  }

  @media (min-width: 900px) {
    .intro {
      @apply max-w-[80rem];
    }
  }
</style>
