---
import Tag from '@/components/UI/Tag.astro';

// The intro at the top of a page: an eyebrow, the page's one h1, and a lead.
// Each page passes its own copy. The homepage also asks for the display-size
// headline, and passes the service tags and the location line.
interface Props {
  eyebrow: string;
  heading: string;
  lead: string;
  /** The homepage hero: a display-size headline, set tight to its lead. */
  display?: boolean;
  /** Tags listed under the lead, with an optional h2 above them. */
  tags?: string[];
  tagsHeading?: string;
  /** A location line, on its own row under the intro. */
  location?: string;
}

const {
  eyebrow,
  heading,
  lead,
  display = false,
  tags = [],
  tagsHeading,
  location,
} = Astro.props;
---

<div class="intro">
  {/* The eyebrow is a label, not a heading, so the page keeps exactly one h1
      and the tags heading sits under it as an h2. */}
  <p class="eyebrow">{eyebrow}</p>
  <h1 class:list={{ intro_headline: display }}>{heading}</h1>
  <p class:list={['lead', { intro_item: display }]}>{lead}</p>
  {
    tags.length > 0 && (
      <>
        {tagsHeading && <h2 class="intro_item">{tagsHeading}</h2>}
        <div class="mt-[2rem]">
          <Tag tags={tags} />
        </div>
      </>
    )
  }
</div>

{
  location && (
    <div class="intro">
      <div class="flex justify-end items-end">
        <p class="intro_item"><span class="material-symbols-outlined">location_on</span>{location}</p>
      </div>
    </div>
  )
}

<style>
  @reference "@/styles/global.css";
  .intro {
    @apply px-[2.5rem] my-[var(--space-section)] mx-auto;
  }

  .intro_item {
    @apply m-0;
  }

  .intro_headline {
    @apply text-display font-medium mt-2 mb-6;
  }

  @media (min-width: 900px) {
    .intro {
      @apply max-w-[80rem];
    }
  }
</style>
