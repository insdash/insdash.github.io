---
import { site, socials } from '@/ts/site';

const year = new Date().getFullYear();
const baseUrl = import.meta.env.BASE_URL;

const footerLinks = [
  { label: 'Work', href: `${baseUrl}projects` },
  { label: 'Services', href: `${baseUrl}services` },
  { label: 'About', href: `${baseUrl}about` },
];
---

<footer>
  <div class="footer_container">
    <div class="footer_top">
      <div>
        <p class="wordmark">
          <a href={`mailto:${site.email}`}>{site.name}</a>
        </p>
        <p class="footer_meta">{site.location}</p>
      </div>

      {/* Nav, socials and the sitemap link were all commented out, leaving the
          footer with no navigation and no outbound proof at all. */}
      <nav aria-label="Footer">
        <ul class="footer_nav">
          {footerLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>

      <ul class="footer_nav">
        {
          socials.map((s) => (
            <li>
              <a href={s.href} rel="noopener noreferrer" target="_blank">
                {s.label}
              </a>
            </li>
          ))
        }
        {/* No link to the personal portfolio. It is written for employers and
            says so up front, which is not where a client weighing a maintenance
            contract should be sent. The portfolio links to this site instead. */}
      </ul>
    </div>

    <hr />
    <nav aria-label="Legal">
      <ul class="footer_legal">
        <li>
          <a href={`${baseUrl}sitemap`}>Sitemap</a>
        </li>
        <li>
          <a href={`${baseUrl}privacy`}>Privacy</a>
        </li>

        <li hidden>
          <button type="button" class="footer_button" data-cookie-settings>
            Cookie settings
          </button>
        </li>
      </ul>
    </nav>

    <div class="footer_copyright">
      <p>
        Copyright &copy; {year} <a href={baseUrl}>{site.name}</a>. All rights reserved.
      </p>
    </div>
  </div>
</footer>

<style>
  @reference "@/styles/global.css";
  footer {
    @apply bg-main/90 text-white;
  }

  a,
  .footer_button {
    @apply  text-white hover:text-[var(--color-text-hover)] hover:text-shadow-[0.05rem_0.05rem_var(--color-text-primary)];
  }

  /* Reads as one of the links above it, but has to be a button: it opens the
     consent bar rather than going anywhere. */
  .footer_button {
    font: inherit;
    @apply bg-transparent border-0 p-0 cursor-pointer;
  }

  .footer_button:focus-visible {
    @apply outline-2 outline-offset-2 outline-white;
  }

  .footer_container {
    @apply px-[2.5rem] py-[2rem];
  }

  .footer_top {
    @apply flex flex-col gap-6 mb-6 md:flex-row md:justify-between;
  }

  .footer_meta {
    @apply font-mono text-meta uppercase m-0 opacity-70;
  }

  .footer_nav {
    @apply flex flex-col gap-2 list-none m-0 p-0 text-sm;
  }

  .footer_legal {
    @apply flex flex-wrap justify-center gap-4 list-none m-0 mt-1 mb-4 p-0 text-sm;
  }

  /* The rule separates the entries visually only — the empty alt text after
     the slash keeps the bar out of the accessibility tree, where a list
     already conveys the boundary. `+` skips a hidden Cookie settings item, so
     a build without a consent bar has no dangling rule. */
  .footer_legal li + li::before {
    content: '|' / '';
    margin-right: 1rem;
  }

  .footer_copyright {
    @apply flex justify-center text-white text-sm;
  }

  @media (min-width: 900px) {
    .footer_container {
      @apply mx-auto max-w-[80rem];
    }
  }
</style>
