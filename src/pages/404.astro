---
import Layout from '@/layouts/Layout.astro';
import ContactSection from '@/components/layout/ContactSection.astro';
import RobotMark from '@/components/UI/RobotMark.astro';

const base = import.meta.env.BASE_URL;
---

<Layout
  title="Page not found"
  noindex={true}
  description="That page doesn't exist. Here's the way back to the work.">
  <section class="notfound">
    <div class="notfound_head">
      <div>
        <p class="eyebrow">404</p>
        <h1>That page doesn't exist.</h1>
      </div>
      <RobotMark entrance="lost" class="notfound_robot" />
    </div>
    <p class="lead">
      It may have moved, or the link may be out of date. The work is all still
      here.
    </p>
    <ul class="notfound_links">
      <li><a href={base}>Home</a></li>
      <li><a href={`${base}projects/`}>Work</a></li>
      <li><a href={`${base}services/`}>Services</a></li>
      <li><a href={`${base}about/`}>About</a></li>
      <li><a href={`${base}robot/`}>Play with Dashili</a></li>
    </ul>
  </section>

  <ContactSection
    lead="Or if you were looking for something specific, just ask."
    robot={false}
  />
</Layout>

<style>
  @reference "@/styles/global.css";

  .notfound {
    @apply px-[2.5rem] my-[var(--space-section)] mx-auto max-w-[80rem];
  }

  .notfound_head {
    @apply flex flex-wrap items-center justify-between gap-6 mb-6;
  }

  .notfound_head h1 {
    @apply mb-0;
  }

  .notfound_robot {
    --robot-size: min(15rem, 60vw);
  }

  .notfound_links {
    @apply list-none p-0 mt-8 flex flex-wrap gap-6;
  }

  .notfound_links a {
    @apply underline underline-offset-4;
  }

  .notfound_links a:hover {
    color: var(--color-text-hover);
  }
</style>
