---
import Layout from '@/layouts/Layout.astro';
import Intro from '@/components/layout/Intro.astro';
import Square from '@/components/grids/Square.astro';
import ContactSection from '@/components/layout/ContactSection.astro';
---

<Layout
  title="Work"
  description="Selected client work from insdash — a design and development studio in Zürich. Menu systems, scheduling software and a print-ready menu generator."
  keywords="design studio Zürich portfolio, web development case studies, UI/UX work">
  <Intro
    eyebrow="Work"
    heading="Things we designed, and things we built."
    lead="Every project here started as a client problem. Some were solved with design, some needed software, and a few began as one and became the other."
  />

  <Square heading="All projects" />

  <ContactSection />
</Layout>
