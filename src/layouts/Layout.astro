---
import Head from '@/components/layout/Head.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Analytics from '@/components/layout/Analytics.astro';
import { analytics } from '@/ts/site';
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  url?: string;
  keywords?: string;
  noindex?: boolean;
}

const { title, description, image, url, keywords, noindex } = Astro.props;
---

<!doctype html>
{/* Defaults to "system" so the palette and the dark: variants resolve correctly
     from the served HTML, before the inline script runs and with JS disabled.
     The script in Head.astro overwrites it with a stored preference. */}
<html lang="en" data-theme="system">
  <Head
    title={title}
    description={description}
    image={image}
    url={url}
    keywords={keywords}
    noindex={noindex}
  />
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    {/* The ID lives in site.ts because the privacy policy names the same
        property and cookie. Changing it there updates both. */}
    <Analytics measurementId={analytics.measurementId} requireConsent={true} />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
